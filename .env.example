DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Show estimated API cost in task results (set false if your model doesn't report cost)
SHOW_COST=true

# Cursor Agent SDK
CURSOR_API_KEY=
# Cursor model id (default: composer-2-fast). See /cursor-models for available models.
# CURSOR_MODEL=composer-2-fast
# Optional model params as JSON array of {id,value} objects, e.g. '[{"id":"thinking","value":"high"}]'
# CURSOR_MODEL_PARAMS=

# Output Cursor SDK progress (tool calls + text deltas) to a Discord thread
# THREAD_PROGRESS=false
