DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Show estimated API cost in task results (set false if your model doesn't report cost)
SHOW_COST=true

# Cursor Agent SDK
CURSOR_API_KEY=
# Cursor model id (default: composer-2). See /cursor-models for available models.
# CURSOR_MODEL=composer-2
# Optional model params as JSON array of {id,value} objects.
# composer-2 default already enables fast mode; pass `[{"id":"fast","value":"false"}]` to disable.
# Other examples: claude-sonnet-4-6 with `[{"id":"thinking","value":"true"},{"id":"effort","value":"max"}]`
# CURSOR_MODEL_PARAMS=

# Output Cursor SDK progress (tool calls + text deltas) to a Discord thread
# THREAD_PROGRESS=false
