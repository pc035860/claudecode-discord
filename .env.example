DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Show estimated API cost in task results (Pi reports real cost)
SHOW_COST=true

# Pi Agent SDK model in pi CLI format: "provider/model-id[:thinkingLevel]".
# The :level suffix is required — without it the session falls back to your
# ~/.pi/agent/settings.json defaultThinkingLevel. See /models for options.
# Auth comes from ~/.pi/agent/auth.json (no API key env needed).
PI_MODEL=openrouter/meta/muse-spark-1.3-contributor:medium

# Output Pi agent progress (tool calls + text deltas) to a Discord thread
# THREAD_PROGRESS=false
